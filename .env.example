# Copy this file to .env.local and adjust for local development if needed.
# .env.local is git-ignored, so your local settings never get committed.
#
# VITE_BASE_PATH controls the sub-path the app is served from.
# See vite.config.js for the full explanation.
#
#   Project page (repo NOT named <username>.github.io):
#     VITE_BASE_PATH=/your-repo-name/
#
#   User/organisation page (repo IS named <username>.github.io):
#     VITE_BASE_PATH=/
#
# Leave this unset for local `npm run dev` — the default "/" is correct
# for local development regardless of how you'll deploy.
VITE_BASE_PATH=/
